{
  "name": "@contentful/skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx/esm 'src/skills/**/*.test.ts'",
    "build": "skill-kit build src/skills/optimization-doctor/skill.ts -o skills/optimization/optimization-doctor",
    "validate": "python3 .disabled/skills/skill-authoring/scripts/quick_validate.py skills --all"
  },
  "devDependencies": {
    "@contentful/skill-kit": "^0.1.6",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
