#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v node &>/dev/null; then
  echo "error: Node.js is required but not found. Install Node.js >= 24." >&2
  exit 1
fi

NODE_VERSION="$(node -e 'process.stdout.write(process.versions.node.split(".")[0])')"
if [ "$NODE_VERSION" -lt 24 ] 2>/dev/null; then
  echo "error: Node.js >= 24 required, found v$(node --version | tr -d v)" >&2
  exit 1
fi

export SKILL_DIR

# skill-kit 1.6.6's composite help printer uses legacy history field names even
# though the protocol validates {step, response, actionResult?}. Keep this
# distributed wrapper truthful until the upstream help text is corrected.
if [[ " ${*:-} " == *" --help "* ]]; then
  node "$SKILL_DIR/bin/contentful-personalization.mjs" "$@" 2>&1 \
    | sed 's/{step, output, action?}/{step, response, actionResult?}/g' >&2
  exit "${PIPESTATUS[0]}"
fi

exec node "$SKILL_DIR/bin/contentful-personalization.mjs" "$@"
